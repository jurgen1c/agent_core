{
  "name": "@jurgen1c/agent-core",
  "version": "0.1.0",
  "description": "Shared runtime primitives for Jurgen's agent development packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurgen1c/agent_core.git"
  },
  "keywords": [
    "agent",
    "sqlite",
    "yaml",
    "repository",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js",
      "default": "./dist/repository.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js",
      "default": "./dist/filesystem.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js",
      "default": "./dist/yaml.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "bun audit --audit-level moderate",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/filesystem.ts src/repository.ts src/sqlite.ts src/yaml.ts --target=node --packages=external --outdir=dist",
    "build:types": "tsc -p tsconfig.build.json",
    "ci": "bun run audit && bun test && bun run lint && bun run typecheck && bun run build",
    "lint": "eslint .",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "is-path-inside": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "engines": {
    "node": ">=25.9.0"
  }
}
